# ============================================
# DataMind AI - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# Only configure the providers you want to use

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Ollama (Local) ---
# No API key needed. Just ensure Ollama is running.
OLLAMA_BASE_URL=http://localhost:11434

# --- Llamafile (Local) ---
# No API key needed. Run llamafile locally on port 8080.
LLAMAFILE_BASE_URL=http://127.0.0.1:8080/v1

# --- Default LLM Provider ---
# Options: llamafile, gemini, openai, ollama
DEFAULT_LLM_PROVIDER=llamafile

# --- Model Assignments ---
# Which model to use for each tier
GEMINI_STRONG_MODEL=gemini-2.5-pro-preview-05-06
GEMINI_FAST_MODEL=gemini-2.0-flash
OPENAI_STRONG_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
OLLAMA_STRONG_MODEL=llama3.3:70b
OLLAMA_FAST_MODEL=qwen2.5:7b
LLAMAFILE_STRONG_MODEL=LLaMA_CPP
LLAMAFILE_FAST_MODEL=LLaMA_CPP

# --- Server ---
HOST=127.0.0.1
PORT=8000
DEBUG=true

# --- Data ---
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
REPORTS_DIR=data/reports
MAX_UPLOAD_SIZE_MB=500
